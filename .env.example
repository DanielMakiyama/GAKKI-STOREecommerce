# Copie para .env (que está no .gitignore) e ajuste o que for preciso.

DB_URL=jdbc:postgresql://localhost:5432/gakki
DB_USERNAME=gakki
DB_PASSWORD=gakki

# Chave de assinatura do JWT. Precisa de no mínimo 32 bytes para HS256.
# Gere uma sua com:  openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48

# Origem do front em desenvolvimento (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DEBUG para ver o SQL gerado pelo Hibernate no console
LOG_SQL=INFO
